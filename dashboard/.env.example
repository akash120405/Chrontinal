# Copy to dashboard/.env.local for local development.
# Set a unique password of at least 12 characters and a random secret of at least 32 bytes.
# Authentication stays disabled until all three values are set.
CLIF_AUTH_USER=
CLIF_AUTH_PASS=
CLIF_AUTH_SECRET=
CLIF_HTTPS=false

# Chat prompts and recent conversation history are sent to Groq when this is set.
# Store the real key in .env.local or the deployment secret manager, never in Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
