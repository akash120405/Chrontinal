# =============================================================================
# CLIF — Environment Configuration (GCP Full-Stack: 28 vCPU / 40 GB)
# =============================================================================
# Copy this file to .env and fill in real values before deploying.
# All empty secret values are required by Docker Compose; never commit .env.
#   cp .env.example .env
#
# Used by: docker-compose.gcp-full.yml
# =============================================================================

# ── GCP ──────────────────────────────────────────────────────────────────────
# External IP of your GCP VM (used for Redpanda advertised addresses).
# Find it with: gcloud compute instances list
GCP_EXTERNAL_IP=YOUR_GCP_VM_EXTERNAL_IP

# Bind data, admin, demo, and monitoring ports to loopback by default.
# Change only for a trusted private interface when remote access is required.
CLIF_PRIVATE_BIND_IP=127.0.0.1
# Vector log ingestion listeners. Restrict these to trusted sender IPs in the
# cloud firewall; set to a private interface IP if ingestion is not public.
VECTOR_INGEST_BIND_IP=0.0.0.0

# ── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_USER=clif_admin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=clif_logs

# ── Redpanda ─────────────────────────────────────────────────────────────────
# Number of partitions per topic (should be >= number of triage agents x 3).
REDPANDA_PARTITIONS=12
# Topic retention in milliseconds (default: 7 days).
REDPANDA_LOG_RETENTION_MS=604800000

# ── MinIO (S3-compatible cold storage) ───────────────────────────────────────
MINIO_ROOT_USER=clif_minio_admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_COLD=clif-cold-logs
MINIO_BUCKET_BACKUPS=clif-backups
MINIO_BUCKET_EVIDENCE=clif-evidence-archive

# ── Go Consumer (Redpanda → ClickHouse) ──────────────────────────────────────
CONSUMER_GROUP_ID=clif-clickhouse-consumer
CONSUMER_BATCH_SIZE=50000
CONSUMER_FLUSH_INTERVAL_SEC=1
CONSUMER_MAX_RETRIES=3
CONSUMER_POLL_BATCH=50000
CONSUMER_FLUSH_WORKERS=4

# ── Vector (log ingestion) ────────────────────────────────────────────────────
VECTOR_LOG_LEVEL=info
# CPU threads for Vector (recommended: ~20% of vCPU count).
VECTOR_THREADS=6

# ── Verifier Agent ────────────────────────────────────────────────────────────
# HMAC key for inter-agent message signing. Generate with:
#   openssl rand -hex 32
CLIF_HMAC_KEY=

# ── Dashboard sign-in and AI assistant ────────────────────────────────────────
# Choose a username, a password of at least 12 characters, and a random
# CLIF_AUTH_SECRET of at least 32 bytes. Example: openssl rand -hex 32.
CLIF_AUTH_USER=
CLIF_AUTH_PASS=
CLIF_AUTH_SECRET=
# Set true when the public dashboard is served behind HTTPS.
CLIF_HTTPS=true
# Server-side Groq API key. Do not expose it with a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Merkle Evidence Chain ─────────────────────────────────────────────────────
# Batch window (seconds) for Merkle tree anchoring.
MERKLE_BATCH_WINDOW=1800
# Daemon polling interval (seconds).
MERKLE_DAEMON_INTERVAL=30

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── SecureBank demo application ──────────────────────────────────────────────
FLASK_SECRET_KEY=
